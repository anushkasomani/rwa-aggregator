{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Module + Target */
    "module": "esnext",                  // Keep ESM syntax
    "moduleResolution": "node",          // Resolve like Node's ESM
    "target": "es2020",                   // Modern JS features

    /* Node types */
    "lib": ["es2020"],
    "types": ["node"],

    /* Source maps + declarations */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strict mode */
    "strict": true,
    "verbatimModuleSyntax": true,         // Keep imports exactly as written
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    /* Misc */
    "skipLibCheck": true
  },
  "include": ["src"],
  
}
